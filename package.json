{
  "name": "ternary-website-v3",
  "version": "1.0.0",
  "description": "Ternary marketing website (Next.js + Payload CMS)",
  "license": "UNLICENSED",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "cross-env NODE_OPTIONS=--no-deprecation next build",
    "dev": "cross-env NODE_OPTIONS=--no-deprecation next dev",
    "dev:webpack": "cross-env NODE_OPTIONS=--no-deprecation next dev --webpack",
    "dev:prod": "cross-env NODE_OPTIONS=--no-deprecation rm -rf .next && pnpm build && pnpm start",
    "generate:importmap": "cross-env NODE_OPTIONS=--no-deprecation payload generate:importmap",
    "generate:types": "cross-env NODE_OPTIONS=--no-deprecation payload generate:types",
    "ii": "cross-env NODE_OPTIONS=--no-deprecation pnpm --ignore-workspace install",
    "lint": "cross-env NODE_OPTIONS=--no-deprecation eslint .",
    "lint:fix": "cross-env NODE_OPTIONS=--no-deprecation eslint . --fix",
    "format": "prettier --write \"**/*.{cjs,mjs,ts,tsx,md,json,css,scss,less,html}\" --ignore-path \".gitignore\" --ignore-path \".prettierignore\"",
    "tailwind:upgrade": "upgrade --force",
    "payload": "cross-env NODE_OPTIONS=--no-deprecation payload",
    "reinstall": "cross-env NODE_OPTIONS=--no-deprecation rm -rf node_modules && rm pnpm-lock.yaml && pnpm --ignore-workspace install",
    "start": "cross-env NODE_OPTIONS=--no-deprecation next start",
    "test": "pnpm run test:int && pnpm run test:e2e",
    "test:e2e": "cross-env NODE_OPTIONS=\"--no-deprecation --no-experimental-strip-types\" pnpm exec playwright test --config=playwright.config.ts",
    "test:int": "cross-env NODE_OPTIONS=--no-deprecation vitest run --config ./vitest.config.mts",
    "prepare": "husky"
  },
  "dependencies": {
    "@eslint/js": "^9.39.5",
    "@hookform/resolvers": "^5.4.0",
    "@payloadcms/admin-bar": "^3.86.0",
    "@payloadcms/db-mongodb": "^3.86.0",
    "@payloadcms/email-nodemailer": "^3.86.0",
    "@payloadcms/live-preview-react": "^3.86.0",
    "@payloadcms/next": "^3.86.0",
    "@payloadcms/payload-cloud": "^3.86.0",
    "@payloadcms/plugin-form-builder": "^3.86.0",
    "@payloadcms/plugin-nested-docs": "^3.86.0",
    "@payloadcms/plugin-redirects": "^3.86.0",
    "@payloadcms/plugin-search": "^3.86.0",
    "@payloadcms/plugin-seo": "^3.86.0",
    "@payloadcms/richtext-lexical": "^3.86.0",
