    "@radix-ui/react-toggle": "^1.1.10",
    "@radix-ui/react-toggle-group": "^1.1.11",
    "@radix-ui/react-tooltip": "^1.2.8",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "cross-env": "^10.1.0",
    "date-fns": "^4.1.0",
    "dotenv": "17.4.2",
    "embla-carousel-react": "^8.6.0",
    "geist": "^1.7.0",
    "graphql": "^16.13.2",
    "input-otp": "^1.4.2",
    "lucide-react": "^1.14.0",
    "mongoose": "^9.6.0",
    "motion": "^12.38.0",
    "next": "16.2.4",
    "next-sitemap": "^4.2.3",
    "next-themes": "^0.4.6",
    "payload": "^3.84.1",
