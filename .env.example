# --- Database (MongoDB) ---
# Payload reads DATABASE_URI first (Payload Cloud injects this), then DATABASE_URL.
DATABASE_URI=mongodb://127.0.0.1/ternary-website

# --- Payload core ---
# Secret used to encrypt JWT tokens and sign Payload data.
PAYLOAD_SECRET=YOUR_SECRET_HERE

# Canonical site URL — CORS, link formatting, media, SEO. No trailing slash.
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# Auto-injected by Vercel in deployments (host only, no scheme). Used as a server-URL
# fallback; leave unset locally.
# VERCEL_PROJECT_PRODUCTION_URL=

# Authorizes Payload cron/job runs (sent as `Bearer <CRON_SECRET>`).
CRON_SECRET=YOUR_CRON_SECRET_HERE

# Authorizes draft-preview requests to /next/preview (admin live preview + Preview button).
# Must match the value set in Vercel; the route returns 403 if the `previewSecret` query param
# does not equal this. Required for live preview to work (WEB-449).
PREVIEW_SECRET=YOUR_SECRET_HERE

# --- S3 media storage (@payloadcms/storage-s3) ---
S3_BUCKET=your-bucket
S3_REGION=ap-southeast-1
S3_ACCESS_KEY_ID=your-access-key-id
S3_SECRET_ACCESS_KEY=your-secret-access-key
S3_MEDIA_PREFIX=media

# --- Amazon SES email (SMTP via corporate-ses-smtp-website / ap-southeast-1) ---
# Payload sends transactional + form-builder notification email through SES. The
# ternary.solutions domain is DKIM-verified and the SES account is in production.
# Leave SMTP_USER/SMTP_PASS unset locally to fall back to a console mock transport.
SMTP_HOST=email-smtp.ap-southeast-1.amazonaws.com
SMTP_PORT=587
SMTP_USER=your-ses-smtp-username
SMTP_PASS=your-ses-smtp-password
EMAIL_FROM_ADDRESS=no-reply@ternary.solutions
EMAIL_FROM_NAME=Ternary Solutions

# --- Admin SSO: Google Workspace (Auth.js v5 / payload-authjs) ---
# Admin login is Google-SSO-only (payload-authjs disables the local email/password strategy). The
# "Sign in with Google" button needs AUTH_GOOGLE_ID/SECRET. Create the OAuth client per
# docs/claude/google-admin-sso.md. New users auto-provision as role 'editor'; promote to 'admin'
# in the admin UI.
AUTH_SECRET=generate-with: openssl rand -base64 33
AUTH_TRUST_HOST=true
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# Optional: comma-separated allowlist. If set, ONLY these emails may sign in (and auto-provision);
# if blank, any verified @ternary.solutions Workspace account may. e.g. ceo@ternary.solutions,cto@ternary.solutions
AUTH_ALLOWED_EMAILS=

# --- Recruiting service (careers / job applications) ---
# Base URL of the ternary recruit API. Consumed once the recruit integration lands (WEB-415).
RECRUIT_API_BASE=https://api.ternary.solutions/recruit/v1/public

# --- Form submission notifications (WEB-452) ---
# Team inbox that receives an email for every form-builder submission (Contact form, etc.),
# sent via the SES email adapter. Falls back to hello@ternary.solutions if unset. With no email
# transport configured (local dev) Payload logs the email to the console instead of sending it.
FORM_NOTIFICATION_EMAIL=hello@ternary.solutions
# From address for outgoing emails (must be an SES-verified sender in production).
EMAIL_FROM_ADDRESS=hello@ternary.solutions
